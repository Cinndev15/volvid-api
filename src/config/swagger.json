                    "example": 28.5
                  },
                  "temperature": {
                    "type": "number",
                    "example": 38.4
                  },
                  "heart_rate": {
                    "type": "integer",
                    "example": 95
                  },
                  "respiratory_rate": {
                    "type": "integer",
                    "example": 24
                  },
                  "mucosa_state": {
                    "type": "string",
                    "example": "Rosadas, TLLC 2 seg"
                  },
                  "body_condition": {
                    "type": "string",
                    "example": "3/5"
                  },
                  "diagnosis": {
                    "type": "string",
                    "example": "Paciente clínicamente sano"
                  },
                  "treatment": {
                    "type": "string",
                    "example": "Aplicación de vacuna séxtuple canina"
                  },
                  "prescription": {
                    "type": "string",
                    "example": "Desparasitante oral cada 3 meses"
                  },
                  "next_control_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-11-24"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Historia clínica creada con código correlativo (ej. HC-0001)"
