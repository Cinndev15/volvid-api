    "/api/medical-records": {
      "post": {
        "tags": [
          "Historias Clínicas"
        ],
        "summary": "Crear una nueva Historia Clínica con consecutivo correlativo por clínica",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "clinic_id",
