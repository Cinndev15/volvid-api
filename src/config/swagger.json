                    "type": "integer",
                    "example": 5
                  },
                  "vet_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "record_type": {
                    "type": "string",
                    "enum": [
                      "consultation",
                      "control",
                      "vaccination",
                      "deworming",
                      "surgery",
                      "emergency"
                    ],
                    "example": "consultation"
                  },
                  "reason": {
                    "type": "string",
                    "example": "Vacunación y chequeo general"
                  },
                  "anamnesis": {
                    "type": "string",
