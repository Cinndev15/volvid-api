{
  "openapi": "3.0.0",
  "info": {
    "title": "Volvid API Documentation",
    "version": "1.0.0",
    "description": "API REST endpoints for the Volvid application, handling veterinary clinic registrations, user administrator credentials, authentication, and the 14-day free trial."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.volvidmascotas.com",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ClinicRegisterPayload": {
        "type": "object",
        "required": [
          "name",
          "phone",
          "size",
          "country",
          "state",
          "city",
          "full_name",
          "email",
          "password",
          "terms_accepted"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Clínica Veterinaria San Francisco"
          },
          "phone": {
            "type": "string",
            "example": "+57 300 123 4567"
          },
          "size": {
            "type": "string",
            "example": "1 - 2 veterinarios"
          },
          "country": {
            "type": "string",
            "example": "Colombia"
          },
          "state": {
            "type": "string",
            "example": "Antioquia"
          },
          "city": {
            "type": "string",
            "example": "Medellín"
          },
          "full_name": {
            "type": "string",
            "example": "Dr. Carlos Mendoza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "carlos@clinicasanfrancisco.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "mypassword123"
          },
          "terms_accepted": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "LoginPayload": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "carlos@clinicasanfrancisco.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "mypassword123"
          }
        }
      },
      "ClinicRegisterResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Clínica registrada exitosamente. Comience su prueba de 14 días."
          },
          "data": {
            "type": "object",
            "properties": {
              "clinic_id": {
                "type": "integer",
                "example": 1
              },
              "clinic_name": {
                "type": "string",
                "example": "Clínica Veterinaria San Francisco"
              },
              "user_email": {
                "type": "string",
                "example": "carlos@clinicasanfrancisco.com"
              },
              "user_name": {
                "type": "string",
                "example": "Dr. Carlos Mendoza"
              },
              "trial_start": {
                "type": "string",
                "format": "date-time",
                "example": "2026-08-23T21:27:24.000Z"
              },
              "trial_end": {
                "type": "string",
                "format": "date-time",
                "example": "2026-09-06T21:27:24.000Z"
              }
            }
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Inicio de sesión exitoso."
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              },
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "example": 1
                  },
                  "clinic_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "full_name": {
                    "type": "string",
                    "example": "Dr. Carlos Mendoza"
                  },
                  "email": {
                    "type": "string",
                    "example": "carlos@clinicasanfrancisco.com"
                  },
                  "role": {
                    "type": "string",
                    "example": "admin"
                  }
                }
              },
              "clinic": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "example": "trial"
                  },
                  "trial_end": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-09-06T21:27:24.000Z"
                  },
                  "is_trial_expired": {
                    "type": "boolean",
                    "example": false
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Los datos proporcionados no son válidos."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "email"
                },
                "message": {
                  "type": "string",
                  "example": "Debe ingresar un correo electrónico válido."
                }
              }
            }
          }
        }
      },
      "PetOwnerRegisterPayload": {
        "type": "object",
        "required": [
          "full_name",
          "email",
          "terms_accepted"
        ],
        "properties": {
          "full_name": {
            "type": "string",
            "example": "Juan Pérez"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "juan.perez@gmail.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "mypassword123",
            "description": "Required only if google_id is not provided."
          },
          "google_id": {
            "type": "string",
            "example": "google-oauth2|10938471209348",
            "description": "Optional Google OAuth unique ID."
          },
          "avatar_url": {
            "type": "string",
            "example": "https://lh3.googleusercontent.com/a/AGNmyxZ...",
            "description": "Optional Google Profile picture URL."
          },
          "terms_accepted": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "PetOwnerRegisterResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Propietario registrado exitosamente."
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              },
              "owner": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "example": 5
                  },
                  "full_name": {
                    "type": "string",
                    "example": "Juan Pérez"
                  },
                  "email": {
                    "type": "string",
                    "example": "juan.perez@gmail.com"
                  },
                  "avatar_url": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "google_id": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  }
                }
              }
            }
          }
        }
      },
      "Breed": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "dog",
              "cat"
            ],
            "example": "dog"
          },
          "name": {
            "type": "string",
            "example": "Golden Retriever"
          }
        }
      },
      "PetRegisterPayload": {
        "type": "object",
        "required": [
          "name",
          "type",
          "breed_id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Luna"
          },
          "type": {
            "type": "string",
            "enum": [
              "dog",
              "cat"
            ],
            "example": "dog"
          },
          "breed_id": {
            "type": "integer",
            "example": 1
          },
          "photo_url": {
            "type": "string",
            "example": "avatar_dog_1.png",
            "description": "Selected avatar filename or profile photo URL."
          },
          "age": {
            "type": "string",
            "example": "2 años, 6 meses",
            "description": "Descriptive age string."
          },
          "fur_color": {
            "type": "string",
            "example": "Marrón"
          },
          "temperament": {
            "type": "string",
            "example": "Tranquilo"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active",
            "default": "active"
          },
          "observations": {
            "type": "string",
            "example": "Tiene todas sus vacunas al día y es muy sociable."
          }
        }
      },
      "Pet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "owner_id": {
            "type": "integer",
            "example": 3
          },
          "breed_id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Luna"
          },
          "type": {
            "type": "string",
            "example": "dog"
          },
          "photo_url": {
            "type": "string",
            "nullable": true,
            "example": "avatar_dog_1.png"
          },
          "age": {
            "type": "string",
            "nullable": true,
            "example": "2 años, 6 meses"
          },
          "fur_color": {
            "type": "string",
            "nullable": true,
            "example": "Marrón"
          },
          "temperament": {
            "type": "string",
            "nullable": true,
            "example": "Tranquilo"
          },
          "status": {
            "type": "string",
            "example": "active"
          },
          "observations": {
            "type": "string",
            "nullable": true,
            "example": "Tiene todas sus vacunas al día y es muy sociable."
          },
          "qr_code": {
            "type": "string",
            "description": "QR code as a base64-encoded PNG data URI (data:image/png;base64,...). Contains pet identification data in JSON format.",
            "example": "data:image/png;base64,iVBORw0KGgo..."
          },
          "breed_name": {
            "type": "string",
            "example": "Golden Retriever"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReportLostPetPayload": {
        "type": "object",
        "required": [
          "lost_location",
          "contact_phone"
        ],
        "properties": {
          "lost_location": {
            "type": "string",
            "example": "Parque El Virrey, Bogotá D.C."
          },
          "lost_date": {
            "type": "string",
            "format": "date",
            "example": "2026-08-26"
          },
          "contact_phone": {
            "type": "string",
            "example": "+57 320 492 3304"
          },
          "reward": {
            "type": "string",
            "example": "$200.000 COP"
          },
          "notes": {
            "type": "string",
            "example": "Lleva collar rojo con placa, es asustadizo pero amigable."
          }
        }
      },
      "LostPetReport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "pet_id": {
            "type": "integer",
            "example": 5
          },
          "owner_id": {
            "type": "integer",
            "example": 7
          },
          "status": {
            "type": "string",
            "example": "active"
          },
          "lost_date": {
            "type": "string",
            "example": "2026-08-26"
          },
          "lost_location": {
            "type": "string",
            "example": "Parque El Virrey, Bogotá"
          },
          "contact_phone": {
            "type": "string",
            "example": "+57 320 492 3304"
          },
          "reward": {
            "type": "string",
            "example": "$200.000 COP"
          },
          "notes": {
            "type": "string",
            "example": "Lleva collar rojo"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "pet_name": {
            "type": "string",
            "example": "Max"
          },
          "pet_type": {
            "type": "string",
            "example": "dog"
          },
          "breed_name": {
            "type": "string",
            "example": "Golden Retriever"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register a new Clinic and Admin User",
        "description": "Registers a veterinary clinic along with its first administrator account. This triggers a 14-day free trial for the clinic in the system and automatically sends a welcome email notification to the administrator's email.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicRegisterPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Clinic and user created successfully. 14-day trial starts and a welcome email is sent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicRegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data, terms not accepted, or email already registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error during registration."
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "User Login / Authenticate",
        "description": "Authenticates a user via email and password, returning a JWT token, user roles, and current clinic trial details.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully logged in. Returns access token and user/clinic status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Correo electrónico o contraseña incorrectos."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/auth/register-owner": {
      "post": {
        "summary": "Register or Login Pet Owner (Form / Google)",
        "description": "Registers a new pet owner. If registered with Google (google_id provided), the password is not required. If the email already exists with a Google account, it performs a login. If it exists as a traditional email/password account, it links the Google account.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PetOwnerRegisterPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pet Owner registered or logged in successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetOwnerRegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation errors, email already exists, or registered with another method.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/breeds": {
      "get": {
        "summary": "Get Breeds Catalog",
        "description": "Returns all dog or cat breeds from the system, ordered alphabetically.",
        "tags": [
          "Catalog"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "dog",
                "cat"
              ]
            },
            "description": "Filter by pet type: dog or cat"
          }
        ],
        "responses": {
          "200": {
            "description": "List of breeds returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Breed"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/pets": {
      "post": {
        "summary": "Register a new Pet",
        "description": "Registers a pet linked to the currently authenticated Owner.",
        "tags": [
          "Pets"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PetRegisterPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pet registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Mascota registrada exitosamente."
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pet"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation errors or invalid breed selected."
          },
          "401": {
            "description": "Unauthorized. Owner JWT token missing or invalid."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "get": {
        "summary": "Get Owner's Pets",
        "description": "Returns all registered pets belonging to the authenticated Owner.",
        "tags": [
          "Pets"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of pets returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pet"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Owner JWT token missing or invalid."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/clients/search": {
      "get": {
        "tags": [
          "Clientes y Pacientes"
        ],
        "summary": "Buscar propietarios y mascotas para vinculación bajo demanda",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Cédula/Documento, Teléfono, Email o Nombre a buscar"
          },
          {
            "name": "clinic_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "ID de la clínica para verificar si ya está vinculado"
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados encontrados con indicador is_linked"
          }
        }
      }
    },
    "/api/clients/link": {
      "post": {
        "tags": [
          "Clientes y Pacientes"
        ],
        "summary": "Vincular una mascota y su propietario a una veterinaria",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "clinic_id",
                  "pet_id"
                ],
                "properties": {
                  "clinic_id": {
                    "type": "integer",
                    "example": 5
                  },
                  "pet_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "notes": {
                    "type": "string",
                    "example": "Primera visita por control"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paciente vinculado exitosamente"
          }
        }
      }
    },
    "/api/clients/clinic/{clinicId}": {
      "get": {
        "tags": [
          "Clientes y Pacientes"
        ],
        "summary": "Listar pacientes vinculados exclusivamente a una veterinaria",
        "parameters": [
          {
            "name": "clinicId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID de la clínica"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filtro de búsqueda por nombre, cédula o raza"
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de pacientes vinculados"
          }
        }
      }
    },
    "/api/vets/clinic/{clinicId}": {
      "get": {
        "tags": [
          "Veterinarios"
        ],
        "summary": "Obtener veterinarios activos de una clínica",
        "parameters": [
          {
            "name": "clinicId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID de la clínica"
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de veterinarios"
          }
        }
      }
    },
    "/api/vets": {
      "post": {
        "tags": [
          "Veterinarios"
        ],
