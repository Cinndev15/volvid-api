    "/api/appointments": {
      "post": {
        "tags": [
          "Citas y Agenda Médica"
        ],
        "summary": "Programar una nueva cita médica para un paciente vinculado",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "clinic_id",
